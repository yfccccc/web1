{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": false
  },
  "include": ["./*.ts", "../lib/**/*.ts"],
  "exclude": ["../node_modules"]
}
